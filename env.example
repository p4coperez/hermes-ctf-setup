# --- Proveedor de modelo (elige uno y rellena su API key) ---
# El modelo debe soportar >= 64.000 tokens de contexto,
# si no, Hermes rechaza el arranque.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

HERMES_MODEL=claude-sonnet-4-6

# --- Perfil / identidad del agente ---
HERMES_PROFILE=ctf-lab

# --- Gateway de mensajería (opcional) ---
# Para hablarle al agente por Telegram en vez de (o además de) la CLI.
# 1. Crea un bot con @BotFather en Telegram y copia el token.
# 2. Averigua tu user id con @userinfobot y ponlo en la whitelist.
HERMES_ENABLE_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=xxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Portal web de configuración/chat ---
# La UI web de Hermes escucha en el puerto 8420 dentro del contenedor.
# Se expone SOLO a localhost del VPS (ver docker-compose.yml) para
# que no quede abierta a internet; accedes a ella vía túnel SSH.
HERMES_ENABLE_WEBUI=true
HERMES_WEBUI_PORT=8420
# Usuario/contraseña de acceso al portal (cámbialos)
HERMES_WEBUI_USER=admin
HERMES_WEBUI_PASSWORD=cambia-esta-clave

# --- Límites internos del agente ---
HERMES_MAX_SUBAGENTS=2          # con 2GB de RAM, no dispares muchos en paralelo
HERMES_WORKSPACE=/workspace

# --- Alcance autorizado para skills de pentest ---
# Rellena SOLO con objetivos que tengas autorización explícita
# para probar (IPs de CTFs, dominios con contrato firmado, etc.)
HERMES_PENTEST_SCOPE="10.10.10.0/24, ctf.hackthebox.com"